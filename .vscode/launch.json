{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1. Run FastAPI OCR & RBAC Gateway",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend_gateway.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8500",
                "--reload"
            ],
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal"
        },
        {
            "name": "2. Pull Ollama Models (OCR + LLM + Embed)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/setup_ollama_models.py",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal"
        },
        {
            "name": "3. Init RAGFlow Department Datasets",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/init_ragflow_datasets.py",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal"
        }
    ]
}